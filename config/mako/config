# Kusogarch - Mako Notification Daemon Configuration

# Position
anchor=top-right
layer=overlay

# Appearance
font=JetBrains Mono Nerd Font 11
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
border-size=2
border-radius=10
padding=12
margin=8
width=350
height=150

# Behavior
default-timeout=5000
ignore-timeout=0
max-visible=3
sort=-time

# Icons
icons=1
max-icon-size=48
icon-path=/usr/share/icons/hicolor

# Formatting
format=<b>%s</b>\n%b
markup=1

# Urgency overrides
[urgency=low]
border-color=#45475a

[urgency=high]
border-color=#f38ba8
default-timeout=10000

[urgency=critical]
border-color=#f38ba8
default-timeout=0
