#!/bin/bash
# Kusogarch - Start wallpaper daemon on login
# Uses hyprpaper on bare metal, swaybg in VMs (hyprpaper requires OpenGL)

CONF="$HOME/.config/hypr/hyprpaper.conf"

# Extract wallpaper path from hyprpaper.conf (literal preload line)
WP=""
if [ -f "$CONF" ]; then
    WP=$(grep -m1 '^preload = ' "$CONF" | sed 's/^preload = //')
    WP="${WP/#\~/$HOME}"
fi

# Save current wallpaper path for other scripts to read
if [ -n "$WP" ] && [ -f "$WP" ]; then
    mkdir -p "$HOME/.config/kusogarch/current"
    echo "$WP" > "$HOME/.config/kusogarch/current/wallpaper-path"
fi

if systemd-detect-virt -q 2>/dev/null; then
    # VM: swaybg (software rendering only)
    if [ -n "$WP" ] && [ -f "$WP" ]; then
        exec swaybg -i "$WP" -m fill
    else
        exec swaybg -c "#1e1e2e"
    fi
else
    # Bare metal: hyprpaper (GPU-accelerated)
    # Verify config has a wallpaper before starting
    if [ -n "$WP" ] && [ -f "$WP" ]; then
        exec hyprpaper
    else
        # No wallpaper configured — start hyprpaper anyway (shows blank)
        exec hyprpaper
    fi
fi
