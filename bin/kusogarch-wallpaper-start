#!/bin/bash
# Kusogarch - Start wallpaper daemon on login
# Uses hyprpaper on bare metal, swaybg in VMs (hyprpaper requires OpenGL)

CONF="$HOME/.config/hypr/hyprpaper.conf"

# Extract wallpaper path from hyprpaper.conf (literal preload line)
WP=""
if [ -f "$CONF" ]; then
    WP=$(grep -m1 '^preload = ' "$CONF" | sed 's/^preload = //')
    WP="${WP/#\~/$HOME}"
fi

# Save current wallpaper path for other scripts to read
if [ -n "$WP" ] && [ -f "$WP" ]; then
    mkdir -p "$HOME/.config/kusogarch/current"
    echo "$WP" > "$HOME/.config/kusogarch/current/wallpaper-path"
fi

if systemd-detect-virt -q 2>/dev/null; then
    # VM: swaybg (software rendering only)
    if [ -n "$WP" ] && [ -f "$WP" ]; then
        exec swaybg -i "$WP" -m fill
    else
        exec swaybg -c "#1e1e2e"
    fi
else
    # Bare metal: hyprpaper (GPU-accelerated)
    # Start hyprpaper in the background, then apply wallpaper via IPC
    # to avoid the race condition where hyprpaper starts before the
    # monitor is ready and the wallpaper never gets applied.
    hyprpaper &
    HYPRPAPER_PID=$!

    if [ -n "$WP" ] && [ -f "$WP" ]; then
        # Wait for hyprpaper to be ready (accepts IPC)
        for i in $(seq 1 20); do
            if hyprctl hyprpaper listloaded &>/dev/null; then
                break
            fi
            sleep 0.25
        done
        # Explicitly apply wallpaper via IPC
        hyprctl hyprpaper preload "$WP" &>/dev/null
        hyprctl hyprpaper wallpaper ",$WP" &>/dev/null
    fi

    wait $HYPRPAPER_PID
fi
