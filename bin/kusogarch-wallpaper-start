#!/bin/bash
# Kusogarch - Start wallpaper daemon on login
# Uses hyprpaper on bare metal, swaybg in VMs (hyprpaper requires OpenGL)

CONF="$HOME/.config/hypr/hyprpaper.conf"

# Extract wallpaper path from hyprpaper.conf
# Handles both formats:
#   preload = /path/to/wallpaper.jpg       (literal path)
#   $WALLPAPER = /path/to/...              (Hyprlang variable)
#   preload = $WALLPAPER
WP=""
if [ -f "$CONF" ]; then
    # First try literal path in preload line
    WP=$(grep -m1 '^preload = ' "$CONF" | sed 's/^preload = //')

    # If it's a variable reference ($WALLPAPER), resolve it
    if [[ "$WP" == \$* ]]; then
        VARNAME="${WP#\$}"
        WP=$(grep -m1 "^\\\$$VARNAME = " "$CONF" | sed "s/^\\\$$VARNAME = //")
    fi

    # Expand ~ to $HOME
    WP="${WP/#\~/$HOME}"
fi

# VM detection
if systemd-detect-virt -q 2>/dev/null; then
    # VM: swaybg (software rendering only)
    if [ -n "$WP" ] && [ -f "$WP" ]; then
        exec swaybg -i "$WP" -m fill
    else
        exec swaybg -c "#1e1e2e"
    fi
else
    # Bare metal: hyprpaper (GPU-accelerated)
    exec hyprpaper
fi
