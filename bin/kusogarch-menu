#!/bin/bash
# kusogarch-menu - Main control menu
# Invoked via Super+Alt+Space

MENU_ITEMS=(
    "Install Package (pacman)"
    "Install Package (AUR)"
    "Remove Package"
    "System Update"
    "---"
    "Theme Selector"
    "Next Wallpaper"
    "Toggle Waybar"
    "Toggle Nightlight"
    "---"
    "WiFi"
    "Bluetooth"
    "Audio Devices"
    "USB Drives"
    "Services"
    "---"
    "Docker"
    "Git"
    "SSH"
    "Ports"
    "---"
    "Power Profile"
    "Monitors"
    "Screen Record"
    "Screen Cast"
    "---"
    "Keybindings Reference"
    "System Info"
    "---"
    "Lock Screen"
    "Power Menu"
)

SELECTION=$(printf '%s\n' "${MENU_ITEMS[@]}" | grep -v '^---$' | \
    fzf --prompt="Kusogarch > " \
        --height=100% \
        --layout=reverse \
        --border=rounded \
        --margin=1 \
        --padding=1 \
        --no-info \
        --header="Kusogarch Control Menu"
)

case "$SELECTION" in
    "Install Package (pacman)")  kusogarch-pkg-install ;;
    "Install Package (AUR)")     kusogarch-pkg-aur-install ;;
    "Remove Package")            kusogarch-pkg-remove ;;
    "System Update")             kusogarch-update ;;
    "Theme Selector")            kusogarch-theme-menu ;;
    "Next Wallpaper")            kusogarch-cmd-wallpaper next ;;
    "Toggle Waybar")             kusogarch-toggle-waybar ;;
    "Toggle Nightlight")         kusogarch-toggle-nightlight ;;
    "WiFi")                      kusogarch-wifi ;;
    "Bluetooth")                 kusogarch-bluetooth ;;
    "Audio Devices")             kusogarch-audio ;;
    "USB Drives")                kusogarch-usb ;;
    "Services")                  kusogarch-services ;;
    "Docker")                    kusogarch-docker ;;
    "Git")                       kusogarch-git ;;
    "SSH")                       kusogarch-ssh ;;
    "Ports")                     kusogarch-ports ;;
    "Power Profile")             kusogarch-power-profile ;;
    "Monitors")                  kusogarch-monitors ;;
    "Screen Record")             kusogarch-record ;;
    "Screen Cast")               kusogarch-cast ;;
    "Keybindings Reference")     kusogarch-menu-keybindings ;;
    "System Info")               fastfetch; echo ""; read -n 1 -p "Press any key..." ;;
    "Lock Screen")               hyprlock & ;;
    "Power Menu")                kusogarch-cmd-powermenu ;;
esac
