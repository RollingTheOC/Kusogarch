#!/bin/bash
# kusogarch-bluetooth - Interactive Bluetooth device manager

echo "Powering on Bluetooth..."
bluetoothctl power on &>/dev/null

echo "Scanning for devices (5 seconds)..."
# Use --timeout to scan within the same bluetoothctl session,
# ensuring discovered devices are registered in the device cache
timeout 5 bluetoothctl --timeout 5 scan on &>/dev/null

# Build device list with connection status
DEVICES=""
while read -r _ mac name; do
    [ -z "$mac" ] && continue
    if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
        status="[connected]"
    elif bluetoothctl info "$mac" 2>/dev/null | grep -q "Paired: yes"; then
        status="[paired]"
    else
        status="[available]"
    fi
    DEVICES+="$(printf "%-40s  %s  %s" "$name" "$status" "$mac")"$'\n'
done < <(bluetoothctl devices)

if [ -z "$DEVICES" ]; then
    echo "No devices found. Make sure your device is in pairing mode."
    echo ""
    read -n 1 -p "Press any key..."
    exit 0
fi

DEVICE=$(printf '%s' "$DEVICES" | fzf --prompt="Bluetooth > " \
        --header="Select device" \
        --layout=reverse \
        --border=rounded \
        --height=100% \
        --no-info
)

if [ -z "$DEVICE" ]; then
    exit 0
fi

MAC=$(echo "$DEVICE" | awk '{print $NF}')
NAME=$(echo "$DEVICE" | sed "s/  *\[.*//")

# Action submenu
if echo "$DEVICE" | grep -q "\[connected\]"; then
    ACTION=$(printf "Disconnect\nTrust\nRemove\nCancel" | \
        fzf --prompt="$NAME > " --layout=reverse --border=rounded --height=100% --no-info)
else
    ACTION=$(printf "Connect\nPair + Trust + Connect\nPair\nTrust\nRemove\nCancel" | \
        fzf --prompt="$NAME > " --layout=reverse --border=rounded --height=100% --no-info)
fi

case "$ACTION" in
    "Connect")    bluetoothctl connect "$MAC" ;;
    "Disconnect") bluetoothctl disconnect "$MAC" ;;
    "Pair + Trust + Connect")
        bluetoothctl pair "$MAC" && \
        bluetoothctl trust "$MAC" && \
        bluetoothctl connect "$MAC"
        ;;
    "Pair")       bluetoothctl pair "$MAC" ;;
    "Trust")      bluetoothctl trust "$MAC" ;;
    "Remove")     bluetoothctl remove "$MAC" ;;
esac

echo ""
read -n 1 -p "Press any key..."
