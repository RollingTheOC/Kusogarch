#!/bin/bash
# kusogarch-bluetooth - Interactive Bluetooth device manager

BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check bluetooth service
if ! systemctl is-active --quiet bluetooth; then
    echo -e "${YELLOW}Bluetooth service not running, starting...${NC}"
    sudo systemctl start bluetooth
    sleep 1
fi

# Power on adapter
bluetoothctl power on &>/dev/null

# Scan using a single bluetoothctl session so discovered devices
# are properly registered with the daemon's device cache
echo -ne "${CYAN}Scanning for devices...${NC}"
{
    echo "scan on"
    sleep 5
    echo "scan off"
    echo "quit"
} | bluetoothctl &>/dev/null

echo -e "\r                            \r"

# Collect all devices (paired + discovered)
LINES=()
while read -r _ mac name; do
    [ -z "$mac" ] && continue
    info=$(bluetoothctl info "$mac" 2>/dev/null)
    if echo "$info" | grep -q "Connected: yes"; then
        tag="connected"
        icon="󰂱"
    elif echo "$info" | grep -q "Paired: yes"; then
        tag="paired"
        icon="󰂯"
    else
        tag="new"
        icon="󰂲"
    fi
    LINES+=("$icon  $name  [$tag]  $mac")
done < <(bluetoothctl devices)

if [ ${#LINES[@]} -eq 0 ]; then
    echo -e "${YELLOW}No devices found.${NC}"
    echo -e "${DIM}Make sure your device is in pairing mode and try again.${NC}"
    echo ""
    read -n 1 -p "Press any key..."
    exit 0
fi

DEVICE=$(printf '%s\n' "${LINES[@]}" | \
    fzf --prompt="  " \
        --header="Bluetooth Devices" \
        --layout=reverse \
        --border=rounded \
        --height=100% \
        --no-info \
        --ansi
)

[ -z "$DEVICE" ] && exit 0

MAC=$(echo "$DEVICE" | awk '{print $NF}')
NAME=$(echo "$DEVICE" | sed 's/^[^ ]* *//;s/  *\[.*//')

# Action submenu based on current state
if echo "$DEVICE" | grep -q "\[connected\]"; then
    ACTION=$(printf "Disconnect\nTrust\nRemove" | \
        fzf --prompt="$NAME > " --header="Connected" --layout=reverse --border=rounded --height=100% --no-info)
elif echo "$DEVICE" | grep -q "\[paired\]"; then
    ACTION=$(printf "Connect\nDisconnect\nTrust\nRemove" | \
        fzf --prompt="$NAME > " --header="Paired" --layout=reverse --border=rounded --height=100% --no-info)
else
    ACTION=$(printf "Pair + Connect\nPair\nTrust" | \
        fzf --prompt="$NAME > " --header="New Device" --layout=reverse --border=rounded --height=100% --no-info)
fi

[ -z "$ACTION" ] && exit 0

echo ""
case "$ACTION" in
    "Pair + Connect")
        echo -e "${CYAN}Pairing...${NC}"
        bluetoothctl pair "$MAC" && \
        bluetoothctl trust "$MAC" && \
        echo -e "${CYAN}Connecting...${NC}" && \
        bluetoothctl connect "$MAC" && \
        echo -e "${GREEN}Connected to $NAME${NC}" || \
        echo -e "${YELLOW}Failed — try again${NC}"
        ;;
    "Connect")
        bluetoothctl connect "$MAC" && \
        echo -e "${GREEN}Connected to $NAME${NC}" || \
        echo -e "${YELLOW}Connection failed${NC}"
        ;;
    "Disconnect")
        bluetoothctl disconnect "$MAC" && \
        echo -e "${GREEN}Disconnected from $NAME${NC}"
        ;;
    "Pair")
        bluetoothctl pair "$MAC" && \
        echo -e "${GREEN}Paired with $NAME${NC}"
        ;;
    "Trust")
        bluetoothctl trust "$MAC" && \
        echo -e "${GREEN}Trusted $NAME${NC}"
        ;;
    "Remove")
        bluetoothctl remove "$MAC" && \
        echo -e "${GREEN}Removed $NAME${NC}"
        ;;
esac

echo ""
read -n 1 -p "Press any key..."
