#!/bin/bash
# kusogarch-cmd-wallpaper - Wallpaper management via hyprpaper
# Usage: kusogarch-cmd-wallpaper [next|set <path>]

KUSOGARCH_DIR="${KUSOGARCH_DIR:-$HOME/.local/share/kusogarch}"
HYPRPAPER_CONF="$HOME/.config/hypr/hyprpaper.conf"
WALLPAPER_DIRS=(
    "$HOME/.config/kusogarch/current/theme"
    "$KUSOGARCH_DIR/wallpapers"
    "$HOME/Pictures/Wallpapers"
)

STATE_FILE="$HOME/.config/kusogarch/current/wallpaper-index"

set_wallpaper() {
    local path="$1"
    path="$(realpath "$path" 2>/dev/null || echo "$path")"

    if [ ! -f "$path" ]; then
        echo "Wallpaper not found: $path"
        return 1
    fi

    # Write hyprpaper config (used by both hyprpaper and swaybg fallback)
    cat > "$HYPRPAPER_CONF" << EOF
# Kusogarch - Hyprpaper (auto-generated by kusogarch-cmd-wallpaper)
preload = $path
wallpaper = ,$path
splash = false
EOF

    # Apply wallpaper: hyprpaper IPC on bare metal, swaybg in VMs
    if systemd-detect-virt -q 2>/dev/null; then
        pkill -x swaybg 2>/dev/null
        sleep 0.3
        swaybg -i "$path" -m fill &>/dev/null &
        disown
        # Watchdog: if swaybg dies within 5s (e.g. hyprctl reload disrupts
        # its layer surface in VMs), restart it automatically.
        (
            for i in 1 2 3 4 5; do
                sleep 1
                if ! pgrep -x swaybg &>/dev/null; then
                    swaybg -i "$path" -m fill &>/dev/null &
                    disown
                fi
            done
        ) &
        disown
    else
        hyprctl hyprpaper unload all &>/dev/null
        hyprctl hyprpaper preload "$path" &>/dev/null
        hyprctl hyprpaper wallpaper ",$path" &>/dev/null
    fi

    # Save current path
    echo "$path" > "$HOME/.config/kusogarch/current/wallpaper-path"

    notify-send "Wallpaper" "$(basename "$path")" 2>/dev/null
}

case "${1:-next}" in
    next)
        # Collect all wallpapers
        WALLPAPERS=()
        for dir in "${WALLPAPER_DIRS[@]}"; do
            if [ -d "$dir" ]; then
                while IFS= read -r -d '' file; do
                    WALLPAPERS+=("$file")
                done < <(find "$dir" -maxdepth 1 -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) -print0 2>/dev/null)
            fi
        done

        if [ ${#WALLPAPERS[@]} -eq 0 ]; then
            notify-send "Wallpaper" "No wallpapers found"
            exit 0
        fi

        # Get current index
        INDEX=0
        if [ -f "$STATE_FILE" ]; then
            INDEX=$(/usr/bin/cat "$STATE_FILE")
        fi

        # Next
        INDEX=$(( (INDEX + 1) % ${#WALLPAPERS[@]} ))
        echo "$INDEX" > "$STATE_FILE"

        set_wallpaper "${WALLPAPERS[$INDEX]}"
        ;;

    set)
        if [ -n "$2" ]; then
            set_wallpaper "$2"
        else
            echo "Usage: kusogarch-cmd-wallpaper set <path>"
        fi
        ;;

    *)
        echo "Usage: kusogarch-cmd-wallpaper [next|set <path>]"
        ;;
esac
